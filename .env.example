# Copy to .env and fill in what you need — everything has a working default
# or offline fallback, nothing here is strictly required to run the tests.

# --- LLM provider keys (at least one needed for real inference) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BYTEZ_API_KEY=

# --- Explicit provider override: openai|anthropic|bytez|ollama ---
# Empty = auto fallback chain (OpenAI -> Anthropic -> Bytez -> None).
# Set to "ollama" to force the free local provider (see below).
LLM_PROVIDER=

# --- Ollama (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- LangFuse (observability — free Cloud tier, sign up at cloud.langfuse.com) ---
# Leave unset to disable tracing entirely (no-op, not an error).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Evaluation judge ---
# Forces the free local judge for scripts/run_eval.py regardless of which
# provider answers queries — keeps eval cost at zero.
EVAL_JUDGE_PROVIDER=ollama
